# --- Base de données (Postgres avec l'extension pgvector) ---
DATABASE_URL=postgresql://user:password@db:5432/palabre

# --- Sécurité : clé que le backend Palabre envoie dans l'en-tête X-API-Key ---
API_KEY=change-me

# --- LLM : n'importe quelle API compatible OpenAI (Groq, OpenRouter, Mistral, Gemini...) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Embeddings (dimension 1024 pour bge-m3 ; si vous changez de modèle, changez EMBEDDING_DIM) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Service voix (STT + TTS clonée). Vide = mode texte uniquement ---
VOICE_SERVICE_URL=
VOICE_SERVICE_KEY=

# --- Table existante de connaissances ---
KB_TABLE=connaissance_base
KB_ID_COL=id
KB_QUESTION_COL=question
KB_ANSWER_COL=response
KB_TYPE_COL=type

# --- Réglages RAG / apprentissage ---
TOP_K=4
MIN_SIMILARITY=0.40
HISTORY_TURNS=8
KB_SYNC_SECONDS=60
AUTO_APPROVE_VOTES=0

DATA_DIR=/data
RECORDINGS_DIR=/recordings
