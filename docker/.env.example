

VITE_API_BASE_URL=http://localhost:4001/api/v1

# Configuration Firebase (authentification fédérée), voir
# backend/docs/FIREBASE_SETUP.md - valeurs publiques (pas de secret).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Services temps réel ─────────────────────────────────────────────────────
# Secret partagé entre tous les services internes (presence, message-router, backend)
INTERNAL_SERVICES_SECRET=change_me_internal_secret

# Cookie Erlang - identique sur tous les noeuds BEAM du cluster
ERLANG_COOKIE=change_me_erlang_cookie

# Clé secrète Phoenix (minimum 64 caractères)
PHOENIX_SECRET_KEY_BASE=change_me_phoenix_secret_key_base_must_be_at_least_64_characters_long

# Hôte public exposé aux clients WebSocket
PUBLIC_HOST=localhost

# URL WebSocket publique communiquée au frontend
VITE_MESSAGE_ROUTER_URL=ws://localhost:4020

# ── File server ─────────────────────────────────────────────────────────────
# URL publique du file server (communiquée aux clients dans les messages médias)
FILE_SERVER_PUBLIC_URL=http://localhost:4030

# Origines autorisées pour les uploads (séparées par virgule, * = toutes)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4020

# ── Call signal ──────────────────────────────────────────────────────────────
# URL publique du call signal (WebSocket signaling)
VITE_CALL_SIGNAL_URL=ws://localhost:4040

# ── Coturn STUN/TURN ─────────────────────────────────────────────────────────
# Domaine realm du serveur TURN
TURN_REALM=palabre.app
# Secret partagé entre le backend et Coturn (REST API credentials)
TURN_SECRET=change_me_turn_secret
# IP publique du VPS (obligatoire si derrière NAT)
TURN_EXTERNAL_IP=
