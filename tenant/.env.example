# =============================================================================
# PALABRE TENANT — Template de configuration
#
# Ce fichier est un exemple. NE PAS utiliser ces valeurs en production.
# Lancez ./setup.sh pour générer un .env complet et sécurisé.
# =============================================================================

# ── Identité de l'organisation — OBLIGATOIRE ──────────────────────────────────
# Fourni dans le QR code reçu lors de l'approbation
ORG_ID=
ORG_NAME=Mon Organisation

# ── Token de contrôle — OBLIGATOIRE ───────────────────────────────────────────
# Fourni dans le QR code reçu lors de l'approbation (usage unique, confidentiel)
CONTROL_TOKEN=

# ── Clés WireGuard — OBLIGATOIRE ──────────────────────────────────────────────
# Fournies dans le QR code reçu lors de l'approbation
WG_PRIVATE_KEY=
WG_PUBLIC_KEY=

# ── Serveur central ────────────────────────────────────────────────────────────
CENTRAL_API_URL=https://api.palabre.app
CENTRAL_WS_URL=wss://ws.palabre.app

# ── Base de données locale ─────────────────────────────────────────────────────
POSTGRES_USER=palabre
POSTGRES_PASSWORD=        # Généré par setup.sh
POSTGRES_DB=palabre_tenant
DATABASE_URL=postgres://palabre:PASSWORD@postgres:5432/palabre_tenant

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=        # Généré par setup.sh
JWT_REFRESH_SECRET=       # Généré par setup.sh

# ── Secrets inter-services — Généré par setup.sh ──────────────────────────────
INTERNAL_SERVICES_SECRET=
ERLANG_COOKIE=
PHOENIX_SECRET_KEY_BASE=

# ── Coturn local ───────────────────────────────────────────────────────────────
TURN_SECRET=              # Généré par setup.sh
TURN_REALM=local.palabre.app
TURN_EXTERNAL_IP=         # IP publique du serveur si derrière NAT

# ── Agent ──────────────────────────────────────────────────────────────────────
AGENT_PORT=8080
HEARTBEAT_INTERVAL_MS=30000
# URL publique de cet agent (pour le routage inter-organisations)
# Doit être accessible depuis le serveur central via Internet ou VPN
# Ex : https://tenant.monentreprise.com:8080
AGENT_PUBLIC_URL=

# ── URLs publiques ─────────────────────────────────────────────────────────────
PUBLIC_HOST=localhost
FILE_SERVER_PUBLIC_URL=http://localhost:4030
MESSAGE_ROUTER_PUBLIC_URL=ws://localhost:4020
