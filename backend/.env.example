# =============================================================
# Palabre Backend - Exemple de variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS mettre de secrets réels dans ce fichier
# =============================================================

# --- Serveur ---
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4001
INSTANCE_ID=

# --- Base de données ---
DATABASE_URL=postgres://palabre:palabre@postgres:5432/palabre

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Firebase (Google / GitHub / Facebook / Apple / TikTok via Firebase Auth fédéré) ---
# Chemin vers le fichier de clé de service (JSON) monté dans le conteneur
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# --- Convessa (OTP WhatsApp) ---
CONVESSA_API_KEY=pk_convessa_xxxxxx
CONVESSA_API_URL=https://convessa.epac-uac-optica-chapter.bj

# --- Mail ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=dglink25@gmail.com
MAIL_PASSWORD=
MAIL_FROM=Palabre <dglink25@gmail.com>

# --- URL du frontend ---
FRONTEND_BASE_URL=http://localhost:3000

# --- Recaptcha ---
RECAPTCHA_SECRET_KEY=

# --- OTP et email ---
EMAIL_OTP_TTL_SECONDS=900
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Passkeys ---
PASSKEY_RP_NAME=Palabre
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000

# --- Sécurité connexion ---
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_WINDOW_SECONDS=900
HEARTBEAT_TTL_SECONDS=90

# --- Super-administrateur ---
SUPER_ADMIN_EMAIL=dglink25@gmail.com
SUPER_ADMIN_STEP_SECRET=
CONFIRMATION_TOKEN_SECRET=
CONFIRMATION_TOKEN_TTL=5m
SUPER_ADMIN_IDLE_TIMEOUT_SECONDS=900

# --- Services temps réel (message-router + presence) ---
# Secret partagé entre les services internes (ne jamais exposer à l'extérieur)
INTERNAL_SERVICES_SECRET=change_me_internal_secret
# URL publique du message router (WebSocket) - exposée aux clients
MESSAGE_ROUTER_PUBLIC_URL=ws://localhost:4020
# URL interne pour les notifications temps réel (dans Docker : http://message-router:4020)
MESSAGE_ROUTER_INTERNAL_URL=http://localhost:4020
ERLANG_COOKIE=change_me_erlang_cookie
PHOENIX_SECRET_KEY_BASE=change_me_phoenix_secret_key_base_must_be_at_least_64_characters_long
PUBLIC_HOST=localhost

# --- File server ---
FILE_SERVER_PUBLIC_URL=http://localhost:4030

# --- Call signal ---
CALL_SIGNAL_PUBLIC_URL=ws://localhost:4040

# --- Coturn TURN server ---
TURN_HOST=localhost
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=change_me_turn_secret
TURN_REALM=palabre.app

# --- JaaS (Jitsi as a Service) ---
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=

# --- Vidéoconférence (white-label Jitsi) ---
# Domaine du serveur Jitsi auto-hébergé (sans https://, sans slash final)
JITSI_DOMAIN=meet.palabre.app
# Secret HMAC pour JWT Jitsi self-hosted (HS256) - laisser vide si JaaS
JITSI_JWT_SECRET=change_me_jitsi_jwt_secret
# Durée max d'un token de session vidéo (secondes)
VIDEO_SESSION_JWT_TTL_SECONDS=86400
# Dossier de stockage des enregistrements (chemin absolu dans le conteneur)
VIDEO_RECORDING_STORAGE_PATH=/data/recordings

# --- Provisionnement tenant local (DNS + Tunnel) ---
# Backend DNS : powerdns | cloudflare | mock (défaut mock pour dev)
DNS_PROVIDER=mock
# PowerDNS API (si DNS_PROVIDER=powerdns)
POWERDNS_API_URL=http://localhost:8053
POWERDNS_API_KEY=change_me_pdns_key
# Domaine racine des sous-domaines tenant
PALABRE_BASE_DOMAIN=palabre.com
# TTL DNS des entrées tenant (secondes)
DNS_TTL=300
# Délai avant qu'un tenant soit marqué inactif (secondes)
TUNNEL_HEARTBEAT_TIMEOUT_SECONDS=180

# --- Service Client (Customer Support) ---
# Capacité maximale de la file d'attente des appels support
SUPPORT_CALL_QUEUE_MAX=10
# Durée max en file avant timeout automatique (secondes)
SUPPORT_CALL_QUEUE_TIMEOUT_SECONDS=600
# Chemin vers le fichier audio de musique d'attente
SUPPORT_HOLD_MUSIC_PATH=/audio/hold-music.mp3

# --- Service AI (FastAPI) ---
# URL interne du service AI (dans Docker : http://ai:8000)
AI_SERVICE_URL=http://localhost:8000
# Clé API partagée avec le service AI (doit correspondre à AI_API_KEY dans ai/.env)
AI_API_KEY=change_me_ai_api_key
# Dossier de stockage des rapports générés (chemin absolu dans le conteneur)
REPORTS_DIR=/data/reports





# Developer Platform
DEVELOPER_PORTAL_URL=http://localhost:3001
DEVELOPER_API_KEY_PREFIX_PUB=pk_live_
DEVELOPER_API_KEY_PREFIX_SEC=sk_live_
DEVELOPER_KEY_ROTATION_GRACE_SECONDS=60
DEVELOPER_STATS_RETENTION_DAYS=90
