# URL de base de l'API Palabre (voir docker-compose.yml — backend exposé en local sur 4001)
VITE_API_BASE_URL=http://localhost:4001/api/v1

# Configuration du projet Firebase (authentification fédérée), voir
# backend/docs/FIREBASE_SETUP.md — ces valeurs viennent de la console
# Firebase (Paramètres du projet > Vos applications > app Web), elles ne
# sont PAS secrètes (contrairement à la clé de service côté backend).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v2 (case à cocher) — clé de SITE publique, voir
# https://www.google.com/recaptcha/admin. Si vide, le composant Recaptcha
# ne s'affiche pas et le backend n'exige alors rien non plus (mode dev).
VITE_RECAPTCHA_SITE_KEY=
